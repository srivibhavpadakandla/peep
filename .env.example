# Google Gemini API key for the orchestration agent.
# Get one free at https://aistudio.google.com/apikey
# Without this, orchestration falls back to a deterministic mock router.
GEMINI_API_KEY=

# Where the browser agent points (defaults to localhost on the same dev server).
SIMULATED_AMAZON_BASE_URL=http://localhost:3000/amazon

# Headed Playwright is useful for the live demo. Set to "0" for headless.
BROWSER_AGENT_HEADED=1

# --- Gmail connect (Settings tab) ---
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Web application, redirect URI: http://localhost:3000/api/auth/callback/google
# Enable the Gmail API for the project. Scope used: gmail.readonly.
# Without these, the Settings tab shows a config notice and the inbox uses the seeded demo data.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required by NextAuth. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Agentic pipeline (executor → Gmail) ---
# Fixed recipient for the executor's send_security_email tool call.
# Never accepts client input — the recipient is always read from this env var.
PEEP_ALERT_RECIPIENT=
