# Anthropic API key for the orchestration agent.
# Without this, orchestration falls back to a deterministic mock router.
ANTHROPIC_API_KEY=

# Where the browser agent points (defaults to localhost on the same dev server).
SIMULATED_AMAZON_BASE_URL=http://localhost:3000/amazon

# Headed Playwright is useful for the live demo. Set to "0" for headless.
BROWSER_AGENT_HEADED=1
